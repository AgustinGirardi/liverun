# LiveRun — portal (cloud/). Copiá a .env y completá.
# Ningún valor real va acá: este archivo SÍ se versiona.

# ── Base y secretos ──────────────────────────────────────────────────────────
# En Render los genera el blueprint (generateValue). En local, cualquier valor
# largo y aleatorio sirve. Si quedan los defaults, el arranque falla a propósito.
CT_CLOUD_DB=sqlite:///cloud.db
CT_CLOUD_SECRET=
CT_PUBLISH_KEY=

# URL pública del portal. Se usa para el back_url de Mercado Pago, el CORS,
# para armar las URLs de avatar al servirlas y los links de los mails.
CT_PUBLIC_URL=http://localhost:8002

# Emails que quedan como admin en cada arranque, separados por coma.
CT_ADMIN_EMAILS=

# ── Mails (verificar email y "olvidé mi contraseña") ─────────────────────────
# SMTP de cualquier proveedor. Puerto 465 = SSL; cualquier otro (587) = STARTTLS.
# Sin CT_SMTP_HOST los mails NO salen: en local se loguean con el link (para
# probar); en producción solo se avisa en el log. Ver DEPLOY.md.
# Ej. Gmail: smtp.gmail.com, 587, tu cuenta y una contraseña de aplicación.
CT_SMTP_HOST=
CT_SMTP_PORT=
CT_SMTP_USER=
CT_SMTP_PASSWORD=
# Remitente que ve el corredor, ej. LiveRun <no-responder@tudominio.com>.
# Vacío = CT_SMTP_USER. Gmail solo deja usar la propia cuenta (o un alias).
CT_SMTP_FROM=

# ── Google Sign-In ───────────────────────────────────────────────────────────
CT_GOOGLE_CLIENT_ID=
CT_GOOGLE_CLIENT_SECRET=
# Solo para desarrollo con Expo Go: habilita redirects a exp://. APAGADO salvo
# que valga exactamente "1". Nunca lo enciendas en producción: un exp:// puede
# apuntar a CUALQUIER proyecto de Expo Go y el callback vuelve con el token de
# sesión en la query, así que alcanzaría un link para robar la cuenta.
CT_ALLOW_EXPO_REDIRECT=

# ── Cobro (Mercado Pago) ─────────────────────────────────────────────────────
# Credencial del vendedor. TEST-... en pruebas, APP_USR-... en producción.
CT_MP_ACCESS_TOKEN=
# Clave secreta del WEBHOOK, del panel de MP. Es un valor DISTINTO del access
# token: si se mezclan, la verificación de firma falla en silencio.
# OBLIGATORIA en producción: sin ella se descartan todos los avisos, porque un
# webhook sin firma deja que cualquiera nos haga consultar la API de MP en bucle
# y nos queme la cuota de la cuenta. En local, si está vacía, no se exige firma.
CT_MP_WEBHOOK_SECRET=

# Precio mensual. La fuente de verdad es el USD; los pesos se calculan al dólar
# del día. CT_PREMIUM_PRICE (ARS fijo) es un override que ignora la cotización.
CT_PREMIUM_PRICE_USD=1.99
CT_PREMIUM_PRICE=
CT_PREMIUM_CURRENCY=ARS

# Cotización: oficial | blue | tarjeta | cripto | mayorista.
CT_USD_RATE_SOURCE=oficial
# Override manual del tipo de cambio (si está, no se consulta la API).
CT_USD_RATE=
# Piso si la API falla y no hay nada cacheado. Solo se usa para MOSTRAR precios:
# nunca para fijar el monto de una suscripción, que se cobra por años.
CT_USD_RATE_FALLBACK=1100
